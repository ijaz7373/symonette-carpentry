{
  "compilerOptions": {
    "target": "ES2019",
    "lib": ["DOM", "ES2019"],
    "module": "None",
    "outDir": "assets/js",
    "rootDir": "src/ts",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "removeComments": true,
    "newLine": "lf"
  },
  "include": ["src/ts/**/*.ts"]
}
